{
  "name": "gtdist-mcp",
  "version": "1.0.0",
  "description": "MCP server for GTDist, a GTD planner: capture, clarify, next actions, projects, weekly review",
  "license": "MIT",
  "author": "Evgeny Savenko",
  "homepage": "https://github.com/exsava76/gtdist-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exsava76/gtdist-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gtd",
    "getting-things-done",
    "gtdist",
    "todo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "gtdist-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
